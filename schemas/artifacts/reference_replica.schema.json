{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Faithful replica payload in proposal metadata.reference_adaptation.replica",
  "type": "object",
  "required": ["fps", "total_frames", "width", "height", "background_color", "units", "captions", "audio"],
  "properties": {
    "fps": {"type": "number", "exclusiveMinimum": 0},
    "total_frames": {"type": "integer", "minimum": 1},
    "width": {"type": "integer", "minimum": 1},
    "height": {"type": "integer", "minimum": 1},
    "background_color": {"type": "string", "minLength": 1},
    "units": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "source_start_frame", "source_end_frame", "action", "composition", "internal_cuts", "material"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source_start_frame": {"type": "integer", "minimum": 0},
          "source_end_frame": {"type": "integer", "minimum": 1},
          "action": {"type": "string", "minLength": 1},
          "composition": {"type": "string", "minLength": 1},
          "internal_cuts": {"type": "array", "items": {"type": "integer", "minimum": 0}},
          "material": {"enum": ["generated_video", "authorized_brand"]}
        },
        "additionalProperties": false
      }
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "unit_id", "start_frame", "end_frame", "text", "style"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "unit_id": {"type": "string", "minLength": 1},
          "start_frame": {"type": "integer", "minimum": 0},
          "end_frame": {"type": "integer", "minimum": 1},
          "text": {"type": "string", "minLength": 1},
          "style": {
            "type": "object",
            "required": ["left", "top", "width", "height", "fontSize", "fontFamily", "fontWeight", "color", "strokeColor", "strokeWidth"],
            "properties": {
              "left": {"type": "number"}, "top": {"type": "number"},
              "width": {"type": "number", "exclusiveMinimum": 0},
              "height": {"type": "number", "exclusiveMinimum": 0},
              "fontSize": {"type": "number", "exclusiveMinimum": 0},
              "fontFamily": {"type": "string", "minLength": 1},
              "fontWeight": {"type": "integer", "minimum": 1, "maximum": 1000},
              "color": {"type": "string", "minLength": 1},
              "strokeColor": {"type": "string", "minLength": 1},
              "strokeWidth": {"type": "number", "minimum": 0},
              "fade_frames": {"type": "integer", "minimum": 0},
              "entrance_scale": {"type": "number", "exclusiveMinimum": 0}
            }, "additionalProperties": false
          }
        }, "additionalProperties": false
      }
    },
    "audio": {
      "type": "object", "required": ["policy", "authorized"],
      "properties": {
        "policy": {"enum": ["reuse_source", "replace", "none"]},
        "authorized": {"type": "boolean"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "provenance": {"type": "string", "minLength": 1}
      },
      "if": {"properties": {"policy": {"enum": ["reuse_source", "replace"]}}},
      "then": {"required": ["path", "sha256", "provenance"], "properties": {"authorized": {"const": true}}},
      "additionalProperties": false
    }
  }, "additionalProperties": false
}
