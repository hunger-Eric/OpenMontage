  "reference_book_source": "Installed Hypit skill snapshot; no upstream commit inferred",
  "changes": [
    "Replaced type-only CliIo dependency with its local write interface.",
    "Removed fetch/prepare-fetch and @hypit/yt-dlp import; OpenMontage retains media acquisition.",
    "Added a local Node runner and pinned sharp/tsx dependency manifest.",
    "Normalized adapted media.ts line endings to LF for byte-stable Git checkouts.",
    "Inspection, seek/timestamps, grids, phrase lookup, motion-change scoring and refusal-to-overwrite algorithms retained."
  ],
  "runtime_dependency": "No Hypit command, installed package, Profile, Runtime or account required."
